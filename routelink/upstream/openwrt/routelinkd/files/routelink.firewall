#!/bin/sh
# OpenWrt-Router-Hub: restore RouteLink iptables FORWARD jump after firewall3 reload.
# No-op on nftables systems (TR3000 / firewall4).

command -v nft >/dev/null 2>&1 && exit 0
command -v iptables >/dev/null 2>&1 || exit 0

restore_chain() {
	local cmd="$1"
	local i=0
	command -v "$cmd" >/dev/null 2>&1 || return 0
	"$cmd" -w 5 -n -L ROUTELINK_BLOCK >/dev/null 2>&1 || return 0

	while [ "$i" -lt 64 ] && "$cmd" -w 5 -D FORWARD -j ROUTELINK_BLOCK 2>/dev/null; do
		i=$((i + 1))
	done

	if [ "$("$cmd" -w 5 -S ROUTELINK_BLOCK 2>/dev/null | grep -c '^-A ROUTELINK_BLOCK ')" -gt 0 ]; then
		"$cmd" -w 5 -I FORWARD 1 -j ROUTELINK_BLOCK 2>/dev/null || true
	fi
}

restore_chain iptables
restore_chain ip6tables
exit 0
